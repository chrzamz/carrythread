{
  "name": "carrythread",
  "version": "0.1.0",
  "description": "Review work across AI agents and carry the right context into the next step.",
  "main": "out/main/index.cjs",
  "type": "module",
  "author": "Chrzam",
  "homepage": "https://chrzamz.github.io/carrythread/",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrzamz/carrythread.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "package": "pnpm build && electron-builder --publish never",
    "site:build": "node scripts/build-site.mjs",
    "site:serve": "node scripts/serve-site.mjs",
    "site:check": "node site/check.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "test:e2e": "pnpm build && tsx tests/e2e.ts"
  },
  "dependencies": {
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "dev.carrythread.desktop",
    "productName": "Carrythread",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "maintainer": "Chrzam <16861672+chrzamz@users.noreply.github.com>",
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "chrzamz",
      "repo": "carrythread"
    }
  }
}
